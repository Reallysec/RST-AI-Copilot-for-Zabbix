# Project-root .env.example — used by the full-stack `docker compose up` here.
# Copy to .env and fill in. (Dev mode at poc/.env is a separate file used when
# running uvicorn locally.)
#
#   cp .env.example .env   &&   edit
#
# BEFORE the first `up`, also create the license fingerprint anchor (see the
# license section below):
#   mkdir -p state && openssl rand -hex 16 > state/machine-id

# ─── LLM (Volcengine Ark / OpenAI / Ollama / vLLM — OpenAI-compatible API) ──────
LLM_API_KEY=your_ark_api_key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=ep-xxxxxxxxxxxxxx-xxxxx
# LLM_TIMEOUT_S=180        # per-call LLM timeout (s); raise if investigate /
#                          # triage / report calls time out

# ─── Auth — SET BOTH IN PRODUCTION ─────────────────────────────────────────────
# RST_GATEWAY_SHARED_SECRET gates every /api/* call (callers send it in the
#   X-RST-Gateway-Token header). Leave empty ONLY for an isolated dev box.
# RST_ADMIN_TOKEN gates config-mutating endpoints (settings / providers).
#   If empty, those are accepted only from 127.0.0.1.
# NOTE: the browser SPA cannot send the shared secret itself — when it is set,
#   front the gateway with a reverse proxy that injects the header. The prod
#   stack (docker-compose.prod.yml + Caddy) does this for you.
RST_GATEWAY_SHARED_SECRET=
RST_ADMIN_TOKEN=
#
# Multi-user password login (off when SSO is on). Accounts live in
# state/users.db (roles admin / analyst / viewer / auditor). The prod stack
# (docker-compose.prod.yml) always turns it on; elsewhere set RST_LOGIN_ENABLED.
# The seed admin is RST_ADMIN_USERNAME (default "admin") with
# RST_ADMIN_PASSWORD_HASH, or the shipped default Admin@123 — remote logins with
# that are refused, so set a hash (deploy.sh does). Generate one with
#   docker run --rm rst-zabbix-ai-copilot-gateway:<tag> python -m backend.session_auth '<password>'
# and paste it DOUBLING every $ as $$ (docker compose escaping).
RST_ADMIN_PASSWORD_HASH=
# RST_LOGIN_ENABLED=true
# RST_ADMIN_USERNAME=admin
# RST_ALLOW_DEFAULT_PASSWORD=false
# RST_SESSION_TTL_HOURS=12
# RST_TRUSTED_USER_HEADER=X-Remote-User   # non-SSO proxy identity (needs shared secret + sso_oidc)
# RST_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12   # peers whose X-Forwarded-*/identity headers are honoured (default shown)

# ─── License (rst-platform license server, online-activation) ──────────────────
# The app public key ships in the image at poc/keys/license_public.pem — no
# config needed. LICENSE_SERVER_URL is the production server below; a release
# image always uses it (and ignores RST_LICENSE_PUBLIC_KEY / RST_CONTENT_PUBLIC_KEY
# overrides) — the overrides only work in a source checkout (local / staging).
LICENSE_SERVER_URL=https://license.reallysec.com
#
# The license SDK binds to a stable host fingerprint. slim images have an empty
# /etc/machine-id and the docker veth MAC is rejected as random, so both compose
# files mount ./state/machine-id into the container. Generate it ONCE:
#   openssl rand -hex 16 > state/machine-id
# NEVER regenerate it — a new file = new hardware = the license must be
# re-activated.

# ─── Zabbix connection ─────────────────────────────────────────────────────────
# The prod stack (docker-compose.prod.yml) connects to the customer's EXISTING
# Zabbix — it ships no Zabbix. ZABBIX_URL is REQUIRED there and must be the
# JSON-RPC endpoint (note the /api_jsonrpc.php suffix). HTTPS is honoured by URL
# scheme (https://…); the client verifies the server cert by default.
ZABBIX_URL=https://zabbix.corp.local/api_jsonrpc.php
# Auth — PREFER a long-lived API token (Zabbix 5.4+: Users → API tokens). When
# set, ZABBIX_USER / ZABBIX_PASSWORD are ignored.
ZABBIX_TOKEN=
# Fallback user/password login (used only when ZABBIX_TOKEN is empty). Give this
# account a read-only role scoped to the host groups analysts should query.
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=
#
# Deep-links ("在 Zabbix 中打开") point the analyst's browser at the Zabbix web
# UI. Set this when ZABBIX_URL is an internal/API host the browser can't reach
# (e.g. behind the gateway network). Leave blank to reuse ZABBIX_URL's origin.
# ZABBIX_PUBLIC_URL=https://zabbix.corp.local
#
# Restrict which host groups are queryable (security control). Empty = all
# groups allowed. Set to the customer's monitored groups.
# RST_INDEX_WHITELIST=Linux servers,Zabbix servers

# ─── Quotas / runtime tuning ───────────────────────────────────────────────────
RST_TRIAL_DAILY_LIMIT=200
# Gateway container resource ceiling (prod compose). Size to the host.
# RST_GATEWAY_CPUS=2
# RST_GATEWAY_MEM=2g
# Per-IP rate limits (requests/minute) — defaults shown. Raise for a larger
# team behind one shared NAT egress IP; lower to cap LLM spend.
# RST_RATELIMIT_GENERATE=30
# RST_RATELIMIT_EXECUTE=30
# RST_RATELIMIT_KIBANA_LINK=120
# RST_MASKING_MODE=cloud   # force cloud / private / airgapped; default = license-derived
# CORS — the SPA is same-origin (served by the gateway), so cross-origin access
# is OFF by default. Set ONLY if hosting the UI on a separate origin:
# RST_CORS_ORIGINS=https://copilot.corp.local   # comma-separated allowlist
#
# Audit (security product → recommend ON). Persists to /app/state/audit.db.
# RST_AUDIT_ENABLED=true
#
# Knowledge base (RAG) — OPTIONAL. Requires a separate embedding endpoint; when
# unset the KB endpoints return a clear 503 and prompts run without augmentation.
# RST_EMBED_MODEL=         # embedding model id (provider-specific)
# RST_EMBED_BASE_URL=      # embedding endpoint, when different from LLM_BASE_URL
#                          # (Ark coding/v3 serves chat only — RAG needs this)
# RST_EMBED_DIM=1536       # embedding vector dimension; must match the model

# Content packs found by an admin update check are applied automatically. Set 0
# to only stage them; an admin then activates one under Content packs (EULA §7).
# RST_CONTENT_AUTO_APPLY=1

# ─── Enterprise SSO (optional — uses docker-compose.sso.yml) ────────────────────
# OIDC / SAML / AD-LDAP login via oauth2-proxy forward-auth. Full guide:
# docs/SSO.md. The SSO compose sets RST_SSO_ENABLED/ENFORCE gateway-side; these
# oauth2-proxy vars come from .env when pointing at the CUSTOMER's IdP:
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=<client id>
# OIDC_CLIENT_SECRET=<client secret>
# OAUTH2_PROXY_SKIP_OIDC_DISCOVERY=false        # real IdP → standard discovery
# OAUTH2_PROXY_COOKIE_SECRET=                   # openssl rand -base64 32
# OAUTH2_PROXY_REDIRECT_URL=https://<site>/oauth2/callback
# OAUTH2_PROXY_COOKIE_SECURE=true
# OAUTH2_PROXY_REVERSE_PROXY=true
# RST_RBAC_ADMIN_GROUPS=soc-admins              # IdP groups granted admin (RBAC)
# RST_RBAC_ANALYST_GROUPS=noc-engineers         # IdP groups granted analyst
# RST_RBAC_VIEWER_GROUPS=noc-viewers            # IdP groups made read-only
# RST_RBAC_AUDITOR_GROUPS=audit-officers        # IdP groups that may only read the audit log
# RST_SEPARATION_OF_DUTIES=1                    # audit log readable by auditors only (三员分立)
# RST_ALERT_SUMMARY_MIN_SEVERITY=warning         # alert AI summaries only at/above this Zabbix severity (default warning)
# RST_ROLE_OVERRIDES=analyst:script.execute     # tighten roles (removals only), see docs/rbac.md
# (SSO needs the enterprise licence feature sso_oidc; unactivated eval installs allowed)
# RST_SSO_ENFORCE=true                          # gated /api/* must carry identity
# Gateway header overrides (default already covers oauth2-proxy X-Auth-Request-*):
# RST_SSO_USER_HEADER=X-Auth-Request-User
# RST_SSO_GROUPS_HEADER=X-Auth-Request-Groups

# ─── Production reverse proxy (docker-compose.prod.yml + Caddy) ─────────────────
# Hostname or IP analysts use to reach the appliance (REQUIRED for the prod
# stack). Multiple allowed, space-separated. Analysts open  https://<this>/v2/
CADDY_SITE_ADDRESS=copilot.corp.local
# Certificate name served to browsers that open a bare IP (no SNI). Defaults to
# CADDY_SITE_ADDRESS; set it when that lists several names.
# CADDY_DEFAULT_SNI=
# Login is the gateway's own (see RST_ADMIN_PASSWORD_HASH above); Caddy only
# terminates TLS and injects the shared secret.
